generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  plugins   Plugin[]
}

model Plugin {
  id          Int      @id @default(autoincrement())
  title       String
  tagline     String?
  description String?
  version     String
  category    String
  price       Float    @default(0)
  fileUrl     String
  iconUrl     String?
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
